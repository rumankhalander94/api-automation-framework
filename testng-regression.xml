<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SmokeSuite">
    <test name="Smoke">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.automation.petstore.tests.PetTests"/>
            <class name="com.automation.petstore.tests.StoreTests"/>
            <class name="com.automation.petstore.tests.UserTests"/>
            <class name="com.automation.petstore.tests.NegativeTests"/>
        </classes>
    </test>
</suite>